[2m2025-10-19T03:47:01.098112Z[0m [32m INFO[0m ToolCall: shell {"command":["bash","-lc","cat <<'EOF' > specs/001-schedule-cook-timer/contracts/openapi.yaml\nopenapi: 3.0.3\ninfo:\n  title: Cooking Schedule Planner API\n  version: 0.1.0\n  description: HTTP endpoints for generating coordinated cooking plans and retrieving baseline food metadata.\nservers:\n  - url: https://localhost:8443\n    description: Local development server (HTTPS preferred for notification permissions)\n\npaths:\n  /api/v1/foods:\n    get:\n      summary: List available food profiles and doneness options\n      operationId: listFoods\n      responses:\n        '200':\n          description: Successful retrieval of food profiles\n          content:\n            application/json:\n              schema:\n                type: object\n                properties:\n                  foods:\n                    type: array\n                    items:\n                      $ref: '#/components/schemas/FoodProfile'\n  /api/v1/plans/generate:\n    post:\n      summary: Generate a coordinated cooking plan for selected foods\n      operationId: generatePlan\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/PlanGenerationRequest'\n      responses:\n        '200':\n          description: Plan generated successfully\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/PlanResponse'\n        '400':\n          description: Invalid input payload\n        '422':\n          description: Business validation failed (e.g., unknown food id, invalid target time)\n  /api/v1/plans/recalculate:\n    post:\n      summary: Adjust an existing plan with updated selections or timing\n      operationId: recalculatePlan\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/PlanAdjustmentRequest'\n      responses:\n        '200':\n          description: Updated plan with recalculated steps\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/PlanResponse'\n        '400':\n          description: Invalid payload\n        '404':\n          description: Plan not recognized (client should re-generate)\n  /api/v1/plans/{planId}:\n    get:\n      summary: Retrieve a previously generated plan for session recovery\n      operationId: getPlan\n      parameters:\n        - name: planId\n          in: path\n          required: true\n          schema:\n            type: string\n            format: uuid\n      responses:\n        '200':\n          description: Plan data returned\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/PlanResponse'\n        '404':\n          description: Plan not found (client should use local fallback)\n\ncomponents:\n  schemas:\n    FoodProfile:\n      type: object\n      required: [id, name, category, doneness_levels]\n      properties:\n        id:\n          type: string\n          description: Unique slug\n        name:\n          type: string\n        category:\n          type: string\n          enum: [protein, vegetable, starch, other]\n        prep_notes:\n          type: string\n        default_rest_minutes:\n          type: integer\n          minimum: 0\n        doneness_levels:\n          type: array\n          items:\n            $ref: '#/components/schemas/DonenessOption'\n    DonenessOption:\n      type: object\n      required: [level, cook_minutes]\n      properties:\n        level:\n          type: string\n        cook_minutes:\n          type: integer\n          minimum: 1\n        prep_buffer_minutes:\n          type: integer\n          minimum: 0\n          default: 0\n    PlanGenerationRequest:\n      type: object\n      required: [mode, items]\n      properties:\n        mode:\n          type: string\n          enum: [start_now, finish_by]\n        target_finish_time:\n          type: string\n          format: date-time\n          description: Required when mode is finish_by\n        items:\n          type: array\n          minItems: 1\n          items:\n            $ref: '#/components/schemas/PlanItemInput'\n        plan_id:\n          type: string\n          format: uuid\n          description: Optional existing plan identifier for recalculation continuity\n    PlanItemInput:\n      type: object\n      required: [food_id, selected_level]\n      properties:\n        food_id:\n          type: string\n        selected_level:\n          type: string\n        servings:\n          type: integer\n          minimum: 1\n          default: 1\n        notes:\n          type: string\n    PlanAdjustmentRequest:\n      type: object\n      required: [plan_id]\n      properties:\n        plan_id:\n          type: string\n          format: uuid\n        remove_food_ids:\n          type: array\n          items:\n            type: string\n        update_durations_seconds:\n          type: object\n          additionalProperties:\n            type: integer\n            description: Duration adjustment in seconds for the corresponding food_id\n        add_steps:\n          type: array\n          items:\n            type: object\n            required: [food_id, offset_seconds, duration_seconds]\n            properties:\n              food_id:\n                type: string\n              offset_seconds:\n                type: integer\n                minimum: 0\n              duration_seconds:\n                type: integer\n                minimum: 0\n              message:\n                type: string\n    PlanResponse:\n      type: object\n      required: [plan]\n      properties:\n        plan:\n          $ref: '#/components/schemas/CookingPlan'\n    CookingPlan:\n      type: object\n      required: [plan_id, mode, items, steps, status, total_duration_seconds]\n      properties:\n        plan_id:\n          type: string\n          format: uuid\n        mode:\n          type: string\n          enum: [start_now, finish_by]\n        start_time:\n          type: string\n          format: date-time\n        target_finish_time:\n          type: string\n          format: date-time\n        status:\n          type: string\n          enum: [Draft, Generated, Active, Completed, Cancelled]\n        items:\n          type: array\n          items:\n            $ref: '#/components/schemas/PlanItem'\n        steps:\n          type: array\n          items:\n            $ref: '#/components/schemas/PlanStep'\n        total_duration_seconds:\n          type: integer\n          minimum: 0\n    PlanItem:\n      type: object\n      required: [food_id, selected_level]\n      properties:\n        food_id:\n          type: string\n        selected_level:\n          type: string\n        servings:\n          type: integer\n          minimum: 1\n        notes:\n          type: string\n    PlanStep:\n      type: object\n      required: [sequence_number, food_id, action, offset_seconds, duration_seconds, message]\n      properties:\n        sequence_number:\n          type: integer\n          minimum: 1\n        food_id:\n          type: string\n        action:\n          type: string\n          enum: [start, flip, rest, serve]\n        offset_seconds:\n          type: integer\n          minimum: 0\n        duration_seconds:\n          type: integer\n          minimum: 0\n        message:\n          type: string\nEOF\n"]}
