         />\n              Finish by specific time\n            </label>\n            <input\n              type=\"datetime-local\"\n              name=\"target_finish_time\"\n              x-bind:disabled=\"mode !== 'finish_by'\"\n              x-bind:required=\"mode === 'finish_by'\"\n              class=\"planner__finish-input\"\n            />\n          </fieldset>\n\n          <div class=\"planner__items\" id=\"food-items\">\n            <template x-for=\"(item, index) in items\" :key=\"item.id\">\n              <div class=\"planner__item\">\n                <label>\n                  Food\n                  <select x-model=\"item.foodId\" class=\"planner__select\" data-food-select>\n                    <option value=\"\">Select food</option>\n                    <template x-for=\"food in foods\" :key=\"food.id\">\n                      <option :value=\"food.id\" x-text=\"food.name\"></option>\n                    </template>\n                  </select>\n                </label>\n                <label>\n                  Doneness\n                  <select x-model=\"item.level\" class=\"planner__select\" data-level-select>\n                    <option value=\"\">Select level</option>\n                    <template x-for=\"option in levelOptions(item.foodId)\" :key=\"option.level\">\n                      <option :value=\"option.level\" x-text=\"option.label\"></option>\n                    </template>\n                  </select>\n                </label>\n                <button\n                  type=\"button\"\n                  class=\"planner__remove\"\n                  x-on:click=\"removeItem(index)\"\n                  x-show=\"items.length > 1\"\n                >\n                  Remove\n                </button>\n              </div>\n            </template>\n          </div>\n\n          <div class=\"planner__actions\">\n            <button type=\"button\" class=\"secondary\" x-on:click=\"addItem()\">\n              Add another item\n            </button>\n            <button type=\"submit\" class=\"primary\">\n              Generate plan\n            </button>\n          </div>\n        </form>\n      </section>\n\n      <section class=\"results\" id=\"plan-results\" aria-live=\"polite\">\n        <h2>Cooking timeline</h2>\n        <p class=\"results__empty\">Add foods and generate a plan to see the schedule.</p>\n      </section>\n\n      <section class=\"timer\" x-data=\"timerComponent()\" x-init=\"init()\" x-show=\"visible\" x-cloak>\n        <h2>Cooking timer</h2>\n        <p class=\"timer__status\" x-text=\"status.toUpperCase()\"></p>\n        <div class=\"timer__meta\" x-show=\"plan\">\n          <p><strong>Plan ID:</strong> <span x-text=\"plan?.plan_id\"></span></p>\n          <p><strong>Elapsed:</strong> <span x-text=\"(elapsedSeconds || 0).toLocaleString()\"></span> sec</p>\n        </div>\n        <div class=\"timer__buttons\">\n          <button type=\"button\" class=\"primary\" x-show=\"status === 'ready'\" x-on:click=\"start()\">Start timer</button>\n          <button type=\"button\" class=\"secondary\" x-show=\"status === 'running'\" x-on:click=\"pause()\">Pause</button>\n          <button type=\"button\" class=\"primary\" x-show=\"status === 'paused'\" x-on:click=\"resume()\">Resume</button>\n        </div>\n        <div role=\"status\" id=\"timer-live-region\" class=\"timer__live\" aria-live=\"assertive\" x-text=\"liveMessage\"></div>\n        <ul class=\"timer__steps\" x-show=\"pendingSteps.length\">\n          <template x-for=\"step in pendingSteps\" :key=\"step.sequence_number\">\n            <li>\n              <div>\n                <strong x-text=\"step.message\"></strong>\n                <p>Starts in <span x-text=\"Math.max(step.offset_seconds - elapsedSeconds, 0)\"></span> sec</p>\n              </div>\n              <button type=\"button\" class=\"secondary\" x-on:click=\"acknowledge(step.sequence_number)\">Acknowledge</button>\n            </li>\n          </template>\n        </ul>\n        <p x-show=\"!pendingSteps.length\" class=\"results__empty\">All steps complete. Enjoy your meal!</p>\n      </section>\n    </main>\n  </body>\n</html>\nEOF\n"]}
