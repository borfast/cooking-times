x-bind:required=\"mode === 'finish_by'\"\n              class=\"planner__finish-input\"\n            />\n          </fieldset>\n\n          <div class=\"planner__items\" id=\"food-items\">\n            <template x-for=\"(item, index) in items\" :key=\"item.id\">\n              <div class=\"planner__item\">\n                <label>\n                  Food\n                  <select x-model=\"item.foodId\" class=\"planner__select\">\n                    <option value=\"\">Select food</option>\n                    <template x-for=\"food in foods\" :key=\"food.id\">\n                      <option :value=\"food.id\" x-text=\"food.name\"></option>\n                    </template>\n                  </select>\n                </label>\n                <label>\n                  Doneness\n                  <select x-model=\"item.level\" class=\"planner__select\">\n                    <option value=\"\">Select level</option>\n                    <template x-for=\"option in levelOptions(item.foodId)\" :key=\"option.level\">\n                      <option :value=\"option.level\" x-text=\"option.label\"></option>\n                    </template>\n                  </select>\n                </label>\n                <button\n                  type=\"button\"\n                  class=\"planner__remove\"\n                  x-on:click=\"removeItem(index)\"\n                  x-show=\"items.length > 1\"\n                >\n                  Remove\n                </button>\n              </div>\n            </template>\n          </div>\n\n          <div class=\"planner__actions\">\n            <button type=\"button\" class=\"secondary\" x-on:click=\"addItem()\">\n              Add another item\n            </button>\n            <button type=\"submit\" class=\"primary\">\n              Generate plan\n            </button>\n          </div>\n        </form>\n      </section>\n\n      <section class=\"results\" id=\"plan-results\" aria-live=\"polite\">\n        <h2>Cooking timeline