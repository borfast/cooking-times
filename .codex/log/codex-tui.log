  type: string\n            format: uuid\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/PlanGenerationRequest'\n      responses:\n        '200':\n          description: Updated plan with recalculated steps\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/PlanGenerationResponse'\n        '400':\n          description: Invalid payload\n        '404':\n          description: Plan not recognized (client should re-generate)\n  /api/v1/plans/{planId}:\n    get:\n      summary: Retrieve a previously generated plan for session recovery\n      operationId: getPlan\n      parameters:\n        - name: planId\n          in: path\n          required: true\n          schema:\n            type: string\n            format: uuid\n      responses:\n        '200':\n          description: Plan data returned\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/PlanGenerationResponse'\n        '404':\n          description: Plan not found (client should use local fallback)\n\ncomponents:\n  schemas:\n    FoodProfile:\n      type: object\n      required: [id, name, category, doneness_levels]\n      properties:\n        id:\n          type: string\n          description: Unique slug\n        name:\n          type: string\n        category:\n          type: string\n          enum: [protein, vegetable, starch, other]\n        prep_notes:\n          type: string\n        default_rest_minutes:\n          type: integer\n          minimum: 0\n        doneness_levels:\n          type: array\n          items:\n            $ref: '#/components/schemas/DonenessOption'\n    DonenessOption:\n      type: object\n      required: [level, cook_minutes]\n      properties:\n        level:\n          type: string\n        cook_minutes:\n          type: integer\n          minimum: 1\n        prep_buffer_minutes:\n          type: integer\n          minimum: 0\n          default: 0\n    PlanGenerationRequest:\n      type: object\n      required: [mode, items]\n      properties:\n        mode:\n          type: string\n          enum: [start_now, finish_by]\n        target_finish_time:\n          type: string\n          format: date-time\n          description: Required when mode is finish_by\n        items:\n          type: array\n          minItems: 1\n          items:\n            $ref: '#/components/schemas/PlanItemInput'\n        plan_id:\n          type: string\n          format: uuid\n          description: Optional existing plan identifier for recalculation continuity\n    PlanItemInput:\n      type: object\n      required: [food_id, selected_level]\n      properties:\n        food_id:\n          type: string\n        selected_level:\n          type: string\n        servings:\n          type: integer\n          minimum: 1\n          default: 1\n        notes:\n          type: string\n    PlanGenerationResponse:\n      type: object\n      required: [plan]\n      properties:\n        plan:\n          $ref: '#/components/schemas/CookingPlan'\n        checksum:\n          type: string\n          description: Hash clients can store to detect stale local data\n    CookingPlan:\n      type: object\n      required: [plan_id, mode, items, steps, status, total_duration_seconds]\n      properties:\n        plan_id:\n          type: string\n          format: uuid\n        mode:\n          type: string\n          enum: [start_now, finish_by]\n        start_time:\n          type: string\n          format: date-time\n        target_finish_time:\n          type: string\n          format: date-time\n        status:\n          type: string\n          enum: [Draft, Generated, Active, Completed, Cancelled]\n        items:\n          type: array\n          items:\n            $ref: '#/components/schemas/PlanItem'\n        steps:\n          type: array\n          items:\n            $ref: '#/components/schemas/PlanStep'\n        total_duration_seconds:\n          type: integer\n          minimum: 0\n    PlanItem:\n      type: object\n      required: [food_id, selected_level]\n      properties:\n        food_id:\n          type: string\n        selected_level:\n          type: string\n        servings:\n          type: integer\n          minimum: 1\n        notes:\n          type: string\n    PlanStep:\n      type: object\n      required: [sequence_number, food_id, action, offset_seconds, duration_seconds, message]\n      properties:\n        sequence_number:\n          type: integer\n          minimum: 1\n        food_id:\n          type: string\n        action:\n          type: string\n          enum: [start, flip, rest, serve]\n        offset_seconds:\n          type: integer\n          minimum: 0\n        duration_seconds:\n          type: integer\n          minimum: 0\n        message:\n          type: string\nEOF\n"],"workdir":"/home/borfast/cooking-times","timeout_ms":120000}
